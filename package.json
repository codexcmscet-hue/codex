{
  "name": "codexclub",
  "version": "1.0.0",
  "private": true,
  "description": "CodeX Club — College Coding Club Management System",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --prefix \"[{name}]\" --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "stop": "npx kill-port 3000 5000",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "test:auth": "npm run test:auth --workspace=backend",
    "test:rbac": "npm run test:rbac --workspace=backend",
    "test:validation": "npm run test:validation --workspace=backend",
    "test:api": "npm run test:api --workspace=backend",
    "create-admin": "npm run create-admin --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "npm run db:migrate --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
