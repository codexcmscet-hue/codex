# ===================================================
#   CodeX Club Environment Configuration (Defaults)
# ===================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Databases (Defaults map to Docker Compose services)
MONGODB_URI=mongodb://localhost:27017/codexclub
DATABASE_URL=postgresql://codexclub:codexclub_secret@localhost:5432/codexclub

# MinIO / AWS S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=codexclub-uploads

# Authentication & JWT Secrets
JWT_SECRET=dev-jwt-secret-do-not-use-in-production-must-be-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=dev-cookie-secret

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@codexclub.local
