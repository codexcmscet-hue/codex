# ============================================================
# CodeX Club — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ── General ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# ── MongoDB (Application Database) ──────────────────────────
MONGODB_URI=mongodb://localhost:27017/codexclub

# ── PostgreSQL (Auth + Content Database) ────────────────────
# For local dev, use the Docker PostgreSQL instance.
# For production, use your Supabase connection string.
DATABASE_URL=postgresql://codexclub:codexclub_secret@localhost:5432/codexclub

# If using Supabase in production:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AWS S3 / MinIO (File Storage) ──────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=codexclub-uploads
# For local dev with MinIO:
AWS_S3_ENDPOINT=http://localhost:9000
# For production AWS S3, remove/comment the endpoint above.

# ── Authentication & Security ──────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=change-me-to-another-random-string
ENCRYPTION_KEY=change-me-32-byte-hex-key-here!!

# ── Email (SMTP) ───────────────────────────────────────────
# For local dev, MailHog catches emails at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@codexclub.local

# For production (e.g., Gmail, AWS SES, Resend):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourclub.com

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug
